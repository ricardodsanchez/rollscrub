.build/
.DS_Store
*.xcuserstate
dupsweep_report.txt
dupsweep_report.csv
rollscrub_report.txt
rollscrub_report.csv
# Anchored to the repo root so it cannot swallow site/releases/, which must
# stay tracked: Cloudflare Pages serves what is committed, so an ignored zip is
# a download link that 404s.
/releases/
# generate_appcast moves deltas it has dropped from the feed here. Nothing
# links to them, so publishing them would only serve dead files.
site/releases/old_updates/
private_keys/
*.p8

# Claude Code's per-machine permissions. They name real paths and filenames
# from the developer's own photo library.
.claude/settings.local.json

# Wrangler local state and logs
.wrangler/

# Xcode workspace and per-user state written when the package is opened in
# Xcode. Local to one machine and one person; nothing here describes the
# package itself.
.swiftpm/
