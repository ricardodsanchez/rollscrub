{
  // Static-assets-only Worker: no `main` script, so Cloudflare serves site/
  // directly. site/ is the domain root, which is what puts the appcast at
  // https://rollscrub.com/appcast.xml — the exact URL compiled into every
  // shipped copy of the app.
  "name": "rollscrub",
  "compatibility_date": "2026-09-12",

  // rollscrub.com is the only way in. Left on, workers.dev and per-version
  // preview URLs would publish the paid installer and the whole site at
  // guessable hostnames, and serve identical content from several domains.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./site"
  }
}
